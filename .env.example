# ---- Database (docker compose) ----
POSTGRES_USER=bhuintel
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bhuintel

# ---- Backend (all variables are prefixed BHU_) ----
BHU_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BHU_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
BHU_CORS_ORIGINS=http://localhost:8080
BHU_ACCESS_TOKEN_MINUTES=480
BHU_MAX_UPLOAD_MB=512
BHU_JOB_TIMEOUT_SECONDS=3600
BHU_RATE_LIMIT_PER_MINUTE=300
BHU_LOGIN_RATE_LIMIT_PER_MINUTE=10
BHU_LOG_LEVEL=INFO
# Bootstrap admin created by `scripts/seed.py` when the users table is empty
BHU_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BHU_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: Copernicus Data Space credentials (downloads are not automated without them)
BHU_COPERNICUS_CLIENT_ID=
BHU_COPERNICUS_CLIENT_SECRET=

# ---- Frontend build ----
# Set to your own tile server for production; "none" disables the basemap.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
