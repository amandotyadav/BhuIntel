# Base URL of the API (empty = same origin; the Vite dev server proxies /api to BHU_API_PROXY)
VITE_API_BASE=
# Basemap tiles. The default OpenStreetMap tile server is for light, interactive use only and requires
# attribution (https://operations.osmfoundation.org/policies/tiles/). Use your own tile server or a
# commercial provider for production. Set VITE_TILE_URL=none to disable the basemap.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
